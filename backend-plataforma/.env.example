DATABASE_URL="postgresql://usuario:contrasena@localhost:5432/examen_sw1?schema=public"

JWT_SECRET="reemplaza-esto-por-un-secreto-largo-y-aleatorio"
# Vida del token en segundos (86400 = 1 dia)
JWT_EXPIRES_IN=86400

# RF11 - Asistente de IA (ia/): completar con tu API key de
# https://console.anthropic.com/ para habilitar el chat. Sin esto,
# POST /projects/:id/ai/chat responde 503 con un mensaje claro.
ANTHROPIC_API_KEY=sk-ant-api03-tu-api-key-aqui
# Opcional: modelo a usar (por defecto claude-sonnet-5 si se deja vacio).
ANTHROPIC_MODEL=

# Notificaciones push (dueño de proyecto): par de claves VAPID para firmar
# los envíos Web Push. Generadas con `npx web-push generate-vapid-keys`.
# VAPID_PUBLIC_KEY debe coincidir con VITE_VAPID_PUBLIC_KEY en frontend-web/.env.
VAPID_PUBLIC_KEY=tu-clave-publica-vapid
VAPID_PRIVATE_KEY=tu-clave-privada-vapid

# Opcional: origen permitido por CORS para el frontend (por defecto
# http://localhost:5173 si se deja sin definir).
FRONTEND_URL=http://localhost:5173
# Opcional: puerto donde escucha la API (por defecto 3000 si se deja sin definir).
PORT=3000
